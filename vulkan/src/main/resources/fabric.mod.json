{
    "schemaVersion": 1,
    "id": "dh-vulkanmod",
    "version": "1.0.0",
    "name": "Distant Horizons — VulkanMod Extension",
    "description": "Adds native Vulkan rendering to Distant Horizons via VulkanMod. Replaces DH's OpenGL pipeline with a Vulkan backend for SSAO, fog, depth compositing, and LOD rendering.",
    "authors": [
        "Braffolk"
    ],
    "license": "LGPL-3.0",
    "icon": "assets/dh-vulkanmod/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.braffolk.dhvulkan.DhVulkanModEntrypoint"
        ]
    },
    "mixins": [
        "dh-vulkanmod.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.17.0",
        "minecraft": "1.21.11",
        "distanthorizons": "*",
        "vulkanmod": "*"
    }
}